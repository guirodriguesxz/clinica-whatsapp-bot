<!-- src/views/partials/header.ejs -->
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <script src="/theme.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= titulo %> — Clínica Exemplo</title>
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#174d32" />
    <link rel="icon" href="/img/app-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/icon-192.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
    />
    <link rel="stylesheet" href="/dashboard.css?v=9" />
  </head>
  <body>
    <% if (typeof usuarioAtual !== "undefined" && usuarioAtual) {
      const caminho = typeof caminhoAtual !== "undefined" ? caminhoAtual : "";
      const ativo = (prefixo) => caminho.startsWith(prefixo);
    %>
    <div class="app-shell">
      <aside class="sidebar">
        <a class="marca" href="/hoje">
          <img class="logo-claro" src="/img/logo-clinica-exemplo-modern.svg" alt="Clínica Exemplo" />
          <img class="logo-escuro" src="/img/logo-clinica-exemplo-modern-dark.svg" alt="Clínica Exemplo" />
        </a>
        <nav class="sidebar-nav" aria-label="Navegação principal">
          <a class="sidebar-link<%= ativo('/hoje') ? ' is-active' : '' %>" href="/hoje"><span>Hoje</span></a>
          <details class="sidebar-group"<%= ativo('/agendamentos') ? " open" : "" %>>
            <summary class="sidebar-group-summary"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 11h18m-13 5h3"/></svg><span>Fisioterapia</span></summary>
            <div class="sidebar-subnav">
              <a class="sidebar-link sidebar-sublink<%= ativo('/agendamentos') && !ativo('/agendamentos/proximos') ? ' is-active' : '' %>" href="/agendamentos"<% if (ativo('/agendamentos') && !ativo('/agendamentos/proximos')) { %> aria-current="page"<% } %>><span>Agendamentos</span></a>
              <a class="sidebar-link sidebar-sublink<%= ativo('/agendamentos/proximos') ? ' is-active' : '' %>" href="/agendamentos/proximos"<% if (ativo('/agendamentos/proximos')) { %> aria-current="page"<% } %>><span>Próximos agendamentos</span></a>
            </div>
          </details>
          <details class="sidebar-group"<%= ativo('/psicologia') ? " open" : "" %>>
            <summary class="sidebar-group-summary"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M7 3v4m10-4v4M3 11h18m-13 5h3"/></svg><span>Psicologia</span></summary>
            <div class="sidebar-subnav">
              <a class="sidebar-link sidebar-sublink<%= ativo('/psicologia') && !ativo('/psicologia/proximos') ? ' is-active' : '' %>" href="/psicologia"<% if (ativo('/psicologia') && !ativo('/psicologia/proximos')) { %> aria-current="page"<% } %>><span>Agendamentos</span></a>
              <a class="sidebar-link sidebar-sublink<%= ativo('/psicologia/proximos') ? ' is-active' : '' %>" href="/psicologia/proximos"<% if (ativo('/psicologia/proximos')) { %> aria-current="page"<% } %>><span>Próximos agendamentos</span></a>
            </div>
          </details>
          <a class="sidebar-link<%= ativo('/pacientes') ? ' is-active' : '' %>" href="/pacientes"<% if (ativo('/pacientes')) { %> aria-current="page"<% } %>><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3m2-16a3 3 0 0 1 0 6m1 3a5 5 0 0 1 3 5v2"/></svg><span>Pacientes</span></a>
          <a class="sidebar-link<%= ativo('/financeiro') ? ' is-active' : '' %>" href="/financeiro"<% if (ativo('/financeiro')) { %> aria-current="page"<% } %>><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="15" rx="3"/><path d="M3 9h18m-5 6h2"/></svg><span>Financeiro</span></a>
          <a class="sidebar-link<%= ativo('/estatisticas') ? ' is-active' : '' %>" href="/estatisticas"<% if (ativo('/estatisticas')) { %> aria-current="page"<% } %>><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3v17h17M9 16v-5m5 5V7m5 9V4"/></svg><span>Estatísticas</span></a>
          <a class="sidebar-link<%= ativo('/psicologos') ? ' is-active' : '' %>" href="/psicologos"<% if (ativo('/psicologos')) { %> aria-current="page"<% } %>><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11a8 8 0 0 1-8 8H7l-4 3V11a9 9 0 0 1 18 0Z"/><path d="M8 10h8m-8 4h5"/></svg><span>Psicólogos</span></a>
          <a class="sidebar-link<%= ativo('/convenios') ? ' is-active' : '' %>" href="/convenios"<% if (ativo('/convenios')) { %> aria-current="page"<% } %>><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3 8 3v6c0 4-5 8-8 9-3-1-8-5-8-9V6Z"/><path d="m8 12 3 3 5-6"/></svg><span>Convênios</span></a>
          <% if (usuarioAtual.papel === "administradora") { %>
          <a class="sidebar-link<%= ativo('/usuarios') ? ' is-active' : '' %>" href="/usuarios"<% if (ativo('/usuarios')) { %> aria-current="page"<% } %>><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg><span>Usuários</span></a>
          <a class="sidebar-link<%= ativo('/fisioterapeutas') ? ' is-active' : '' %>" href="/fisioterapeutas"<% if (ativo('/fisioterapeutas')) { %> aria-current="page"<% } %>><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg><span>Fisioterapeutas</span></a>
          <a class="sidebar-link<%= ativo('/base-conhecimento') ? ' is-active' : '' %>" href="/base-conhecimento"<% if (ativo('/base-conhecimento')) { %> aria-current="page"<% } %>><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9M12 4h9M4 4h.01M4 12h.01M4 20h.01M8 4h13M8 12h13M8 20h13" transform="translate(-4 0)"/><circle cx="4" cy="7" r="1.5"/><circle cx="4" cy="12" r="1.5"/><circle cx="4" cy="17" r="1.5"/></svg><span>Base de conhecimento</span></a>
          <a class="sidebar-link<%= ativo('/sugestoes-conhecimento') ? ' is-active' : '' %>" href="/sugestoes-conhecimento"<% if (ativo('/sugestoes-conhecimento')) { %> aria-current="page"<% } %>><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 18h.01M12 6a3 3 0 0 1 1.8 5.4c-.9.7-1.8 1.3-1.8 2.6"/><circle cx="12" cy="12" r="9"/></svg><span>Sugestões de conhecimento</span></a>
          <a class="sidebar-link<%= ativo('/configuracoes/prestador') ? ' is-active' : '' %>" href="/configuracoes/prestador"<% if (ativo('/configuracoes/prestador')) { %> aria-current="page"<% } %>><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 7h6m-6 4h6m-6 4h6m-3 6v-3"/></svg><span>Dados do prestador</span></a>
          <% } %>
          <a class="sidebar-link<%= ativo('/minha-senha') ? ' is-active' : '' %>" href="/minha-senha"<% if (ativo('/minha-senha')) { %> aria-current="page"<% } %>><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3m-4 4v3"/></svg><span>Trocar senha</span></a>
        </nav>
      </aside>
      <div class="app-main">
        <header class="topbar">
          <button class="button button--quiet topbar-voltar" type="button" onclick="history.back()">← Voltar</button>
          <button type="button" class="button button--quiet" data-theme-toggle aria-pressed="false">Tema escuro</button>
          <p class="topbar-context"><%= titulo %></p>
          <form method="post" action="/logout" class="form-logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <span><strong><%= usuarioAtual.nome %></strong><small><%= usuarioAtual.papel === "administradora" ? "Administradora" : "Recepção" %></small></span>
            <button class="button button--quiet" type="submit">Sair</button>
          </form>
        </header>
        <main class="page-content">
    <% } %>
    <% if (typeof usuarioAtual === "undefined" || !usuarioAtual) { %>
    <main class="app-main-simple">
    <% } %>

<%- include('../partials/header', { titulo: 'Hoje' }) %>
<header class="page-header"><div><p class="eyebrow">Recepção · <%= dataHoje %></p><h1>Seu dia na Clínica Exemplo</h1><p>Atendimentos, evolução e pagamentos em um só lugar.</p></div><a class="button" href="/agendamentos/novo">Novo agendamento</a></header>
<% if (mensagem) { %><p class="sucesso" role="status"><%= mensagem %></p><% } %>
<section class="today-summary" aria-label="Resumo do dia"><% for (const [chave, texto] of [['total','Atendimentos'],['confirmados','Aguardando'],['compareceram','Compareceram'],['faltaram','Faltaram']]) { %><div class="panel"><strong><%= resumo[chave] %></strong><span><%= texto %></span></div><% } %></section>
<% if (itens.some((item) => item.status !== 'cancelado')) { %>
<form id="form-presenca-lote" class="bulk-actions screen-only" method="post" action="/agendamentos/presenca-lote">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <input type="hidden" name="retorno_url" value="/hoje" />
  <label class="presenca-lote-label"><input type="checkbox" id="selecionar-todos-presenca" aria-label="Selecionar todos" /> Marcar todos</label>
  <span id="contador-selecionados-presenca" class="contador-selecionados">Nenhum selecionado</span>
  <button type="submit" name="presenca" value="compareceu">Compareceu</button>
  <button type="submit" name="presenca" value="faltou">Faltou</button>
</form>
<% } %>
<section class="today-list">
<% if (!itens.length) { %><div class="panel"><h2>Agenda livre por aqui</h2><p>Nenhum atendimento para hoje.</p><a href="/agendamentos">Consultar outros dias</a></div><% } %>
<% itens.forEach((item) => { %>
<article class="panel today-appointment">
<header class="today-appointment-header">
<% if (item.status !== 'cancelado') { %><label class="presenca-lote-label" title="Selecionar para marcar presença em lote"><input type="checkbox" name="itens" value="<%= item.origem %>:<%= item.id %>" class="presenca-lote-checkbox" form="form-presenca-lote" aria-label="Selecionar <%= item.paciente_nome %>" /></label><% } %>
<strong class="appointment-time"><%= item.hora.slice(0,5) %></strong><div><h2><%= item.paciente_nome %></h2><p><%= item.tipo_atendimento %> · <%= item.psicologo_nome || item.fisioterapeuta_nome || item.profissional_responsavel || 'Equipe Clínica Exemplo' %></p></div><span class="badge <%= item.status === 'compareceu' ? 'is-success' : item.status === 'faltou' ? 'is-warning' : '' %>"><%= item.status %></span></header>
<div class="today-actions">
<a class="button button--quiet" href="<%= item.paciente_id ? `/pacientes/${item.paciente_id}/ficha` : `/pacientes?busca=${encodeURIComponent(item.paciente_nome)}` %>">Ficha do paciente</a>
<% if (item.paciente_id) { %><a class="button button--quiet" href="/pacientes/<%= item.paciente_id %>/ficha?imprimir=1" target="_blank" title="Imprimir ficha do paciente">🖨️ Ficha</a><% } %>
<% if (item.status !== 'cancelado') { %>
<details><summary class="button button--quiet">Presença e prontuário</summary>
<form method="post" action="/agendamentos/<%= item.origem %>/<%= item.id %>/presenca">
<input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="retorno" value="hoje" />
<label>Presença<select name="presenca" required><option value="">Selecione</option><option value="compareceu" <%= item.presenca === 'compareceu' ? 'selected' : '' %>>Chegou / compareceu</option><option value="faltou" <%= item.presenca === 'faltou' ? 'selected' : '' %>>Faltou</option></select></label>
<label>Evolução da sessão<textarea name="observacao_sessao" rows="3"><%= item.observacao_sessao ?? '' %></textarea></label>
<label>Profissional responsável<input name="profissional_responsavel" value="<%= item.profissional_responsavel ?? '' %>" /></label><button>Salvar atendimento</button></form></details>
<% } %>
<details><summary class="button button--quiet">Registrar pagamento</summary><form method="post" action="/financeiro/<%= item.origem === 'bot' ? 'agendamento' : 'importado' %>/<%= item.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="retorno" value="hoje" /><label>Valor (R$)<input type="number" name="valor" min="0.01" step="0.01" required /></label><label>Forma<select name="forma_pagamento"><option value="pix">Pix</option><option value="cartao">Cartão</option><option value="convenio">Convênio</option></select></label><label>Status<select name="status"><option value="pago">Pago</option><option value="pendente">Pendente</option><option value="aguardando_reembolso">Aguardando reembolso</option></select></label><label>Data<input type="date" name="data" value="<%= dataHoje %>" required /></label><button>Salvar pagamento</button></form></details>
<a class="button button--quiet" href="/financeiro?data=<%= dataHoje %>&busca=<%= encodeURIComponent(item.paciente_nome) %>">Ver pagamentos</a>
<% if (item.status === 'confirmado' && !item.ja_passou) { %><form method="post" action="/agendamentos/<%= item.origem %>/<%= item.id %>/confirmar-whatsapp"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="retorno" value="hoje" /><button class="button button--quiet">Confirmar por WhatsApp</button></form><% } %>
</div></article><% }) %></section>
<script>
  document.getElementById("selecionar-todos-presenca")?.addEventListener("change", (evento) => {
    document.querySelectorAll(".presenca-lote-checkbox").forEach((checkbox) => {
      checkbox.checked = evento.target.checked;
    });
    atualizarContadorSelecionadosHoje();
  });

  function atualizarContadorSelecionadosHoje() {
    const contador = document.getElementById("contador-selecionados-presenca");
    if (!contador) return;
    const total = document.querySelectorAll(".presenca-lote-checkbox:checked").length;
    contador.textContent = total === 0 ? "Nenhum selecionado" : total === 1 ? "1 selecionado" : `${total} selecionados`;
  }
  document.querySelectorAll(".presenca-lote-checkbox").forEach((checkbox) => {
    checkbox.addEventListener("change", atualizarContadorSelecionadosHoje);
  });
</script>
<%- include('../partials/footer') %>

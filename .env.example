# Servidor
PORT=3000

# Evolution API (self-hosted) — instância de WhatsApp Business já conectada
EVOLUTION_API_URL=https://sua-evolution-api.exemplo.com
EVOLUTION_API_KEY=sua-api-key-da-evolution
EVOLUTION_INSTANCE_NAME=clinicaexemplo

# Segredo próprio (gere com: openssl rand -hex 32) usado na URL do webhook
# (https://SEU-DOMINIO/webhook/<este-valor>) para garantir que só a Evolution
# API consiga chamar essa rota.
WEBHOOK_SECRET=

# Chave própria (gere com: openssl rand -hex 32) exigida no header
# x-admin-api-key para usar a rota POST /admin/base-conhecimento.
ADMIN_API_KEY=

# Número (com DDI, só dígitos) que recebe notificações de encaminhamento
# humano e avisos de erro fatal do servidor
ATENDENTE_HUMANO_TELEFONE=5511999999999

# Lembrete automático de consulta (WhatsApp). DESLIGADO por padrão — revise o
# texto da mensagem em src/services/lembreteService.js com a clínica antes de
# ativar, já que ele manda mensagem direto pro paciente sem revisão humana.
# Um único lembrete, na véspera da consulta. Agendamento marcado pro mesmo
# dia (sem véspera possível) não recebe lembrete.
LEMBRETE_CONSULTA_ATIVADO=false
# A partir de que hora, na véspera, o lembrete é enviado.
LEMBRETE_CONSULTA_HORA_VESPERA=18
# Minuto de corte junto com a hora acima (ex: HORA=19 + MINUTO=30 = 19:30).
LEMBRETE_CONSULTA_MINUTO_VESPERA=0
# Trava de teste: se preenchida (telefones separados por vírgula), os lembretes
# (véspera e tarde) só saem para esses números. Vazia = envia para todos.
LEMBRETE_SO_TELEFONES=

# Lembrete "de tarde" (WhatsApp), same-day — cobre consultas marcadas pro
# próprio dia (o lembrete de véspera acima nunca dispara pra esse caso).
# DESLIGADO por padrão — revise o texto em
# src/services/lembreteService.js (montarMensagemLembreteTarde) antes de
# ativar. Dispara uma vez, às 12h (fuso da clínica), pra quem tem consulta
# hoje à tarde (hora >= 12:00) e ainda não recebeu esse lembrete.
LEMBRETE_TARDE_ATIVADO=false
# A partir de que hora do dia o lembrete de tarde é enviado.
LEMBRETE_TARDE_HORA=12

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Observabilidade (Sentry). Opcional — sem essa variável, os erros continuam
# só no console (comportamento padrão em desenvolvimento local). Em produção,
# configure com o DSN do projeto criado em sentry.io (ver README, seção
# "Observabilidade").
SENTRY_DSN=

# Banco de dados (Postgres — recomendado: Neon, plano gratuito)
# No Neon: a connection string já aparece em destaque no dashboard do projeto
# (inclui "?sslmode=require" — mantenha assim). Também funciona com Supabase
# ou qualquer outro Postgres acessível, só trocando essa URL.
DATABASE_URL=postgresql://usuario:senha@host/nomedobanco?sslmode=require
# Deixe "true" (padrão) — funciona tanto pro Neon quanto pro Supabase. Use
# "false" só para Postgres local sem SSL.
DATABASE_SSL=true
# Deixe sem definir (padrão: valida o certificado TLS de verdade — testado e
# funciona com o Neon). Defina "false" só se trocar pra um provedor cujo
# certificado o Node não reconheça (ex: alguns poolers do Supabase) —
# desligar a validação deixa a conexão vulnerável a um MITM.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Segredo da sessão do dashboard (gere com: openssl rand -hex 32).
SESSION_SECRET=
